<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="441.0" prefWidth="685.0" spacing="20.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.SecondaryController">
    <children>
      <HBox prefHeight="17.0" prefWidth="115.0">
         <children>
            <Label fx:id="lblContador" text="#" />
              <Label fx:id="lblPreguntas" text="Preguntas" />
         </children>
         <VBox.margin>
            <Insets left="230.0" right="250.0" />
         </VBox.margin>
      </HBox>
      <HBox prefHeight="18.0" prefWidth="435.0" spacing="20.0">
         <children>
            <Label text="Número de Preguntas Restantes:" />
            <Label fx:id="lblPreguntasRestantes" text="PreguntasRestantes" />
         </children>
         <padding>
            <Insets left="120.0" />
         </padding>
      </HBox>
      <Button fx:id="btnSi" mnemonicParsing="false" onAction="#btnSi" prefHeight="28.0" prefWidth="58.0" text="Si" />
      <Button fx:id="btnNo" mnemonicParsing="false" onAction="#btnNo" prefHeight="25.0" prefWidth="60.0" text="No" />
      <HBox prefHeight="157.0" prefWidth="481.0">
         <children>
            <VBox prefHeight="157.0" prefWidth="595.0">
               <children>
                  <Label text="Sálida" />
                  <TextArea fx:id="txtSalida" prefHeight="140.0" prefWidth="510.0" />
               </children>
               <HBox.margin>
                  <Insets left="30.0" />
               </HBox.margin>
            </VBox>
         </children>
      </HBox>
        <Button fx:id="secondaryButton" onAction="#switchToPrimary" text="Inicio" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
