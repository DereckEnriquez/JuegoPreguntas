<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="370.0" prefWidth="590.0" spacing="20.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.PrimaryController">
   <children>
      <Label prefHeight="17.0" prefWidth="183.0" text="Ingrese la cantidad de preguntas:" />
      <TextField fx:id="txtnPreguntas" prefHeight="25.0" prefWidth="360.0">
         <VBox.margin>
            <Insets left="200.0" right="200.0" />
         </VBox.margin>
      </TextField>
      <Button fx:id="primaryButton" onAction="#switchToSecondary" text="Continuar" />
      <Label fx:id="lblError" textFill="RED" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
